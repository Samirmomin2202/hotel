# Server port
PORT=4400

# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017/hotel-booking

# Secret used to sign JWTs
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Comma-separated list of allowed frontend origins (for CORS)
FRONTEND_URLS=http://localhost:5173

# Razorpay credentials. Keep all secret values on the backend only.
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_test_key_secret
RAZORPAY_TEST_WEBHOOK_SECRET=

# Optional NexaDesk-compatible RAG API. Set the base URL and a non-revoked
# integration key created in NexaDesk. The backend calls /api/chat for you.
RAG_API_URL=
RAG_API_KEY=
RAG_API_QUERY_FIELD=message
RAG_API_AUTH_HEADER=Authorization
RAG_API_AUTH_SCHEME=Bearer
RAG_API_TIMEOUT_MS=15000
